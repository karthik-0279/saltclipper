# ==========================================
# SECURITY & SENSITIVE CREDENTIALS (CRITICAL)
# ==========================================
# Never commit environment files containing secrets, API keys, and passwords
.env
.env.*
!.env.example
*.env

# Local OAuth tokens, credentials & session state
youtube_tokens.json
oauth_config.json
*tokens*.json
*credentials*.json
youtube_quota_tracker.json

# ==========================================
# TEMPORARY MEDIA & DISK ARTIFACTS
# ==========================================
# Video segments, downloaded streams, and ffmpeg temp renders
temp_clips/
temp_clips/*
temp/
*.mp4
*.m4a
*.webm
*.part
*.ytdl

# ==========================================
# LARGE BINARY EXECUTABLES
# ==========================================
# Platform-specific binaries (ffmpeg, yt-dlp) - do not bloat git history
bin/
bin/*
*.exe
*.dll

# ==========================================
# DEPENDENCIES & BUILD OUTPUTS
# ==========================================
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ==========================================
# LOGS & DEBUGGING
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ==========================================
# OPERATING SYSTEM & EDITOR JUNK
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
